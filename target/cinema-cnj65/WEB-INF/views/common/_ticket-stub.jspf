<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%--
  FRAGMENT DUNG CHUNG: render 1 "ve xe" (ticket-stub).
  YEU CAU: bien EL "ticket" (Model Ticket, da co ticket.details) phai ton tai
  trong scope (request attribute hoac bien vong lap c:forEach) TRUOC khi
  include file nay. Dung boi: ticket-success.jsp, my-tickets.jsp, ticket-detail.jsp.

  Style: xem assets/css/ticket-stub.css — moi thay doi giao dien ve xe chi
  can sua o 1 file CSS do, khong sua rai rac o tung trang.
--%>
<div class="cnj-ticket cnj-mb-4">
  <span class="cnj-badge
    ${ticket.status == 'PAID' ? 'cnj-badge--success' : ''}
    ${ticket.status == 'PENDING' ? 'cnj-badge--warning' : ''}
    ${ticket.status == 'CANCELLED' ? 'cnj-badge--danger' : ''}
    ${ticket.status == 'CHECKED_IN' ? 'cnj-badge--neutral' : ''}
    cnj-ticket__status">
    <c:choose>
      <c:when test="${ticket.status == 'PAID'}">Đã thanh toán</c:when>
      <c:when test="${ticket.status == 'PENDING'}">Chờ thanh toán</c:when>
      <c:when test="${ticket.status == 'CANCELLED'}">Đã hủy</c:when>
      <c:when test="${ticket.status == 'CHECKED_IN'}">Đã check-in</c:when>
    </c:choose>
  </span>

  <div class="cnj-ticket__main">
    <div class="cnj-ticket__movie"><c:out value="${ticket.movieTitle}" /></div>

    <div class="cnj-ticket__row">
      <div class="cnj-ticket__field">
        <span class="cnj-ticket__field-label">Phòng</span>
        <span class="cnj-ticket__field-value"><c:out value="${ticket.roomName}" /></span>
      </div>
      <div class="cnj-ticket__field">
        <span class="cnj-ticket__field-label">Suất chiếu</span>
        <span class="cnj-ticket__field-value"><c:out value="${ticket.showDateFormatted}" /> · <c:out value="${ticket.startTimeFormatted}" /></span>
      </div>
      <div class="cnj-ticket__field">
        <span class="cnj-ticket__field-label">Tổng tiền</span>
        <span class="cnj-ticket__field-value cnj-text-gold"><c:out value="${ticket.totalAmountFormatted}" /></span>
      </div>
    </div>

    <div class="cnj-ticket__seats">
      <c:forEach var="d" items="${ticket.details}">
        <span class="cnj-ticket__seat-chip"><c:out value="${d.seatCode}" /></span>
      </c:forEach>
    </div>

    <c:if test="${showTicketDetailButton}">
    <a href="${pageContext.request.contextPath}${ticketDetailUrl}${ticket.id}"
       class="cnj-btn cnj-btn--ghost cnj-btn--sm cnj-mt-4">
        Xem chi tiết →
    </a>
</c:if>
  </div>

  <div class="cnj-ticket__stub">
    <span class="cnj-ticket__code"><c:out value="${ticket.ticketCode}" /></span>
    <div class="cnj-ticket__qr" title="Mã QR minh họa"></div>
  </div>
</div>
